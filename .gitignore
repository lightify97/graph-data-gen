.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Raw cached API responses. Large, and fully regenerable by
# `python -m app.services.ingestion.fetch_all` — the cache is for speed and
# reproducibility within a working copy, not something to commit.
data/seeds/*/
!data/seeds/.gitkeep

# The normalised bundle IS worth keeping: it pins exactly which upstream records
# were pulled, and regenerating it hits 15 public APIs.
!data/seeds/seed_bundle.json

# Live client health report — regenerable by `python -m app.services.ingestion.check_clients`
# against endpoints that change independently of this repo.
data/generated/source_client_report.json

.DS_Store
.env
